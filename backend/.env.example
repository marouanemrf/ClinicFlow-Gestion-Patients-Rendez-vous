NODE_ENV=development
PORT=5000

# Local PostgreSQL (`docker compose up -d db` exposes it on port 5433).
DATABASE_URL=postgres://clinicflow:clinicflow@localhost:5433/clinicflow
# Set to true for hosted databases (Aiven, RDS...). Optionally provide the provider CA certificate.
DATABASE_SSL=false
PG_CA_CERT_PATH=

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Allowed frontend origin(s), comma-separated.
CLIENT_URL=http://localhost:5173

# Defines "today" for the dashboard and how date-times without offset are interpreted.
CLINIC_TIMEZONE=Africa/Casablanca
BCRYPT_ROUNDS=10

# Folder where patient photos are stored (default: backend/uploads).
UPLOAD_DIR=
