{
  "name": "clinicflow-backend",
  "version": "1.0.0",
  "description": "ClinicFlow REST API (Express + PostgreSQL)",
  "main": "src/server.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "db:reset": "node --env-file-if-exists=.env scripts/reset.js",
    "test": "node --env-file-if-exists=.env.test --env-file-if-exists=.env.test.local node_modules/jest/bin/jest.js --runInBand"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  }
}
